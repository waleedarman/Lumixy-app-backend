APP_NAME=Lumixy
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.example.com
TRUSTED_HOSTS=staging.example.com
TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8
SANCTUM_EXPIRATION=1440
CORS_ALLOWED_ORIGINS=https://staging.example.com,https://admin-staging.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Shared across multiple app instances (do NOT use file on staging)
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lumixy_staging
DB_USERNAME=lumixy
DB_PASSWORD=change-me

# --- Redis (required for realistic multi-instance load tests) ---
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_CONNECTION=default
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=default

# Local machine WITHOUT Redis (do not use these on staging):
# CACHE_STORE=file
# CACHE_STORE=redis_with_file_fallback
# SESSION_DRIVER=file
# QUEUE_CONNECTION=database
# QUEUE_CONNECTION=redis_with_database_fallback

LUMIXY_PUBLIC_LOOKUP_CACHE_TTL=3600
LUMIXY_PUBLIC_PROVIDER_CACHE_TTL=60

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Media stays on Bunny CDN (clients load images directly; Laravel only uploads/deletes)
FILESYSTEM_DISK=local
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_API_KEY=
BUNNY_STORAGE_HOST=storage.bunnycdn.com
BUNNY_CDN_URL=
BUNNY_VERIFY_SSL=true

FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_VERIFY_SSL=true
# Optional public HTTPS logo URL for Android notification large icon (defaults to APP_URL/lumixy-logo.png)
FIREBASE_NOTIFICATION_IMAGE_URL=

# Google OAuth (Laravel Socialite — mobile deep-link flow)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/auth/google/callback"
FRONTEND_DEEP_LINK=lumixy://auth/google

PCBS_VERIFY_SSL=true
