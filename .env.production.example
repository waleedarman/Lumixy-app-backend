APP_NAME=Lumixy
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example
TRUSTED_HOSTS=your-domain.example
TRUSTED_PROXIES=10.0.0.10,10.0.0.11
SANCTUM_EXPIRATION=1440
CORS_ALLOWED_ORIGINS=https://your-web-app.example,http://127.0.0.1:5173,http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lumixy
DB_USERNAME=lumixy
DB_PASSWORD=change-me
MYSQL_ATTR_SSL_CA=/absolute/path/to/provider-ca.pem

CACHE_STORE=redis
# Local/dev without Redis: CACHE_STORE=file  OR  CACHE_STORE=redis_with_file_fallback
SESSION_DRIVER=redis
SESSION_CONNECTION=default
# Local/dev without Redis: SESSION_DRIVER=file  OR  SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=redis
# Local/dev without Redis: QUEUE_CONNECTION=database  OR  QUEUE_CONNECTION=redis_with_database_fallback

# Multi-instance: share maintenance mode via Redis (not per-node files)
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_CONNECTION=default
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=default

LUMIXY_PUBLIC_LOOKUP_CACHE_TTL=3600
LUMIXY_PUBLIC_PROVIDER_CACHE_TTL=60

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_API_KEY=
BUNNY_STORAGE_HOST=storage.bunnycdn.com
BUNNY_CDN_URL=
BUNNY_VERIFY_SSL=true

FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_VERIFY_SSL=true
# Optional public HTTPS logo URL for Android notification large icon (defaults to APP_URL/lumixy-logo.png)
FIREBASE_NOTIFICATION_IMAGE_URL=

# Google OAuth (Laravel Socialite — mobile deep-link flow)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/auth/google/callback"
FRONTEND_DEEP_LINK=lumixy://auth/google

PCBS_VERIFY_SSL=true
