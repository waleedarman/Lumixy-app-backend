# Local development template (not for production).
# Copy relevant keys into .env as needed.

APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1/test/TEST/backend/public

# Local performance testing only (APP_ENV=local). Keep false for normal daily use.
PERF_TEST_MODE=false

# Google OAuth (Laravel Socialite — mobile deep-link flow)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/auth/google/callback"
FRONTEND_DEEP_LINK=lumixy://auth/google
